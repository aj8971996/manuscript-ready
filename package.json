  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/react": "~19.1.0",
    "@types/react-test-renderer": "~19.1.0",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~10.0.0",
    "eslint-config-prettier": "^10.1.8",
    "fast-xml-parser": "^5.5.11",
    "jest": "^30.3.0",
    "jest-expo": "~54.0.12",
    "jszip": "^3.10.1",
    "prettier": "^3.8.2",
    "react-test-renderer": "19.1.0",
    "tailwindcss": "^3.4.17",
    "ts-jest": "^29.4.9",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.2"
  },
  "private": true
